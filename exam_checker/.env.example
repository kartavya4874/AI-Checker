# ========================================
# Hybrid AI Exam Checker — Environment
# ========================================

# --- API Keys (REQUIRED) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
GOOGLE_VISION_CREDENTIALS=./service-account.json

# --- Database ---
# DATABASE_URL=sqlite:///exam_checker.db

# --- OpenAI Models ---
# OPENAI_EVAL_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Grade Boundaries (JSON) ---
# GRADE_BOUNDARIES={"A+": 90, "A": 80, "B+": 70, "B": 60, "C+": 50, "C": 40, "D": 33, "F": 0}

# --- Processing ---
# NEGATIVE_MARKING_FACTOR=0.0
# RATE_LIMIT_RPM=50
# MAX_RETRIES=3
# RETRY_BASE_DELAY=2.0

# --- Portal ---
# PORTAL_HOST=127.0.0.1
# PORTAL_PORT=8000
